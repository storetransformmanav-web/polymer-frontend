# Copy this file to .env.local and fill in real values.
# Only variables prefixed with VITE_ are exposed to client code.

# Base URL for the backend API. The default `/api` is proxied to
# https://polymeruk-api.vercel.app by Vite in dev/preview (see
# vite.config.ts) because the backend rejects browser CORS from localhost.
#
# Two ways to run in production (set this variable in Vercel, then redeploy —
# it is baked in at build time):
#   1. `/api` (default): the browser calls your own site and vercel.json
#      forwards /api/* to the backend. Works on every domain, no CORS.
#   2. The full backend URL, e.g.
#      VITE_API_BASE_URL=https://polymeruk-api.vercel.app/api
#      The browser then calls the backend directly (its host is allowed in the
#      CSP `connect-src` in vercel.json). This only works on origins the backend
#      lists in its CORS settings — currently just https://polymer-frontend.vercel.app —
#      and adds a CORS preflight request before authenticated calls.
# Keep `/api` in .env.local for local development (the backend rejects localhost).
VITE_API_BASE_URL=/api

# Google OAuth "Web application" client ID, used for "Sign in with Google".
# Leave empty to hide the Google button. In Google Cloud Console, add every
# origin you serve the app from (e.g. http://localhost:5173 and your
# production URL) under "Authorized JavaScript origins". The backend must
# verify tokens issued for this same client ID.
VITE_GOOGLE_CLIENT_ID=836410745604-2gdp1g5rukhm1elmhmqkcq7hl8u1pe6j.apps.googleusercontent.com
