# Copy this file to .env.local and fill in real values.
# Only variables prefixed with VITE_ are exposed to client code.

# Base URL for the backend API. The default `/api` is proxied to
# https://polymeruk-api.vercel.app by Vite in dev/preview (see
# vite.config.ts) because the backend rejects browser CORS from localhost.
# For a production build, either route `/api` to the backend at your host
# (rewrite/reverse proxy) or set the full URL, e.g.
# VITE_API_BASE_URL=https://polymeruk-api.vercel.app/api — which requires the
# backend to allow your deployed origin in its CORS settings.
VITE_API_BASE_URL=/api

# Google OAuth "Web application" client ID, used for "Sign in with Google".
# Leave empty to hide the Google button. In Google Cloud Console, add every
# origin you serve the app from (e.g. http://localhost:5173 and your
# production URL) under "Authorized JavaScript origins". The backend must
# verify tokens issued for this same client ID.
VITE_GOOGLE_CLIENT_ID=836410745604-2gdp1g5rukhm1elmhmqkcq7hl8u1pe6j.apps.googleusercontent.com
